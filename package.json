{
  "name": "wageclaw-electron",
  "version": "0.2.1",
  "private": true,
  "description": "WageClaw Electron desktop app",
  "author": "OpenAI Codex",
  "main": "electron/main.cjs",
  "scripts": {
    "start": ".tools/node/bin/node .tools/npm/bin/npm-cli.js exec electron .",
    "electron": ".tools/node/bin/node .tools/npm/bin/npm-cli.js exec electron .",
    "dist:mac": ".tools/node/bin/node .tools/npm/bin/npm-cli.js exec electron-builder -- --mac",
    "dist:mac:dmg:localfix": "PATH=$(pwd):$PATH .tools/node-adhoc/bin/node node_modules/electron-builder/cli.js --mac dmg"
  },
  "build": {
    "appId": "com.wageclaw.electron",
    "productName": "WageClawElectron",
    "directories": {
      "buildResources": "electron/assets",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "main.js",
      "styles.css",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  }
}
