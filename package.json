{
  "name": "wageclaw-electron",
  "version": "0.3.0",
  "private": true,
  "description": "忍了吧 WageClaw desktop app",
  "author": "OpenAI Codex",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dist:mac": "npm run build && electron-builder -- --mac",
    "dist:mac:dmg:localfix": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "com.wageclaw.electron",
    "productName": "忍了吧 WageClaw",
    "directories": {
      "buildResources": "electron/assets",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
